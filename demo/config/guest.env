# guest.env — 容器环境变量模板
# 对标真实架构：/opt/hatch/runtime-cell/guest.env
# 由 orchestrator.sh 每次渲染为 /var/lib/demo/run/guest.env，
# 以只读方式 bind 进容器（"the cell cannot edit it"）。
#
# 本地密钥不要写在这里：复制一份为 demo/.env（不会被提交），
# orchestrator 会把它渲染为 guest.local.env 覆盖同名变量。

DEMO_HOME=/home/demo
DEMO_MOCK=1

# --- 真实模型模式：DEMO_MOCK=0，并在 demo/.env 里设置下面三项（OpenAI 兼容接口） ---
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
